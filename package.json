{
  "name": "agentport",
  "version": "0.0.13",
  "private": true,
  "description": "NIP-07 for agents: bring your own agent to any website.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force && tsc -p tsconfig.harness.json --noEmit && npm run typecheck:bundled",
    "typecheck:bundled": "tsc -p examples/inkwell/tsconfig.json && tsc -p site/tsconfig.json && tsc -p site/tsconfig.worker.json && tsc -p wallet/tsconfig.json && tsc -p packages/extension/tsconfig.json --noEmit",
    "relay": "tsx packages/relay/src/cli.ts",
    "daemon": "tsx packages/daemon/src/cli.ts",
    "demo": "tsx examples/inkwell/src/serve.ts",
    "e2e": "tsx scripts/e2e.ts",
    "webmcp:harvest": "tsx scripts/webmcp-harvest.ts",
    "wire:check": "tsx scripts/wire-check.ts",
    "acp:check": "tsx scripts/acp-permission-check.ts",
    "runtime:check": "tsx scripts/acp-runtime-check.ts",
    "agui:check": "tsx packages/agui/check.ts",
    "build:extension": "tsx packages/extension/build.ts",
    "check:extension": "npm run check -w @agentport/extension",
    "clean": "rm -rf packages/*/dist examples/*/dist",
    "site:build": "tsx site/build.ts",
    "wallet:build": "tsx wallet/build.ts",
    "wallet:check": "tsx scripts/wallet-popup-check.ts",
    "client:check": "tsx scripts/client-check.ts",
    "site:dev": "npm run site:build && wrangler dev",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:ci": "tsx scripts/deploy.ts --ci",
    "connect": "tsx packages/daemon/src/connect-cli.ts",
    "ui:smoke": "tsx scripts/ui-smoke.ts",
    "ui:extension-smoke": "tsx scripts/extension-ui-smoke.ts",
    "integration": "tsx scripts/integration.ts",
    "docs:check": "tsx scripts/docs-check.ts",
    "snippet:check": "tsx scripts/snippet-check.ts",
    "deployed:check": "tsx scripts/deployed-check.ts",
    "source:check": "tsx scripts/source-check.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@nisli/core": "^0.54.1",
    "@nisli/ui": "^0.4.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "wrangler": "4.120.0"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.64.0",
    "@agentclientprotocol/sdk": "^1.3.0",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.1",
    "codemirror": "^6.0.2",
    "ws": "^8.18.0"
  }
}
