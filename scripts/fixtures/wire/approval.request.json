{
  "type": "approval.request",
  "cases": [
    {
      "name": "minimal valid",
      "expect": "ok",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": ""
      }
    },
    {
      "name": "maximal valid: summary at 4096-char limit, call present",
      "expect": "ok",
      "frame": {
        "t": "approval.request",
        "s": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.b:c",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "call": {
          "name": "inkwell.document.replaceSelection",
          "arguments": {
            "text": "Rewritten paragraph"
          }
        }
      }
    },
    {
      "name": "missing summary",
      "expect": "missing_key",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool"
      }
    },
    {
      "name": "call missing arguments",
      "expect": "missing_key",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "write",
        "call": {
          "name": "inkwell.document.replaceSelection"
        }
      }
    },
    {
      "name": "unknown extra key",
      "expect": "unexpected_key",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "urgency": "high"
      }
    },
    {
      "name": "call with unknown key",
      "expect": "unexpected_key",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "call": {
          "name": "inkwell.document.read",
          "arguments": {},
          "id": "x"
        }
      }
    },
    {
      "name": "call is a string",
      "expect": "wrong_type",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "call": "read"
      }
    },
    {
      "name": "summary one char over limit",
      "expect": "too_long",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": ""
      }
    },
    {
      "name": "call name with forbidden character",
      "expect": "bad_format",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "call": {
          "name": "bad name!",
          "arguments": {}
        }
      }
    },
    {
      "name": "call arguments nesting-depth bomb (20 levels)",
      "expect": "too_deep",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "call": {
          "name": "inkwell.document.read",
          "arguments": {
            "d": {
              "d": {
                "d": {
                  "d": {
                    "d": {
                      "d": {
                        "d": {
                          "d": {
                            "d": {
                              "d": {
                                "d": {
                                  "d": {
                                    "d": {
                                      "d": {
                                        "d": {
                                          "d": {
                                            "d": {
                                              "d": {
                                                "d": {
                                                  "leaf": true
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "raw: whitespace is non-canonical",
      "expect": "non_canonical",
      "raw": "{\"t\":\"approval.request\",\"s\":\"s1\",\"id\":\"a1\", \"summary\":\"\"}"
    },
    {
      "name": "raw: __proto__ smuggle",
      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{},\"id\":\"a1\",\"s\":\"s1\",\"summary\":\"\",\"t\":\"approval.request\"}"
    },
    {
      "name": "approval without an authority domain",
      "expect": "missing_key",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "summary": ""
      }
    },
    {
      "name": "authority domain outside the closed set",
      "expect": "bad_format",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "page_tool",
        "summary": ""
      }
    },
    {
      "name": "valid: a site tool the grant lent",
      "expect": "ok",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "site_tool",
        "summary": ""
      }
    },
    {
      "name": "valid: the call digest",
      "expect": "ok",
      "frame": {
        "t": "approval.request",
        "s": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.b:c",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "call": {
          "name": "inkwell.document.replaceSelection",
          "arguments": {
            "text": "Rewritten paragraph"
          }
        },
        "callHash": "b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7"
      }
    },
    {
      "name": "call digest is not 32 bytes",
      "expect": "bad_format",
      "frame": {
        "t": "approval.request",
        "s": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.b:c",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "",
        "call": {
          "name": "inkwell.document.replaceSelection",
          "arguments": {
            "text": "Rewritten paragraph"
          }
        },
        "callHash": "b7b7"
      }
    },
    {
      "name": "approval summary carries an ANSI escape that would overwrite the line above",
      "expect": "bad_format",
      "frame": {
        "t": "approval.request",
        "s": "s1",
        "id": "a1",
        "domain": "runtime_own_tool",
        "summary": "Harmless\u001b[1A\u001b[2K  Approve?"
      }
    }
  ]
}
