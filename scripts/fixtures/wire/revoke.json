{
  "type": "revoke",
  "cases": [
    {
      "name": "minimal valid \u2014 as a client sends it, before the relay stamps",
      "expect": "ok",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "origin": "https://inkwell.example"
      }
    },
    {
      "name": "maximal valid \u2014 relay-stamped, origin at the length limit",
      "expect": "ok",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "origin": "https:.example",
        "client": "c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2c2"
      }
    },
    {
      "name": "missing origin",
      "expect": "missing_key",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
      }
    },
    {
      "name": "empty origin",
      "expect": "too_short",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "origin": ""
      }
    },
    {
      "name": "origin one char over the limit",
      "expect": "too_long",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "origin": "https:.example"
      }
    },
    {
      "name": "unknown extra key",
      "expect": "unexpected_key",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "origin": "https://inkwell.example",
        "reason": "because I said so"
      }
    },
    {
      "name": "origin is an object",
      "expect": "wrong_type",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "origin": {
          "host": "inkwell.example"
        }
      }
    },
    {
      "name": "agent uppercase hex",
      "expect": "bad_format",
      "frame": {
        "t": "revoke",
        "agent": "A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1A1",
        "origin": "https://inkwell.example"
      }
    },
    {
      "name": "origin carries an unpaired surrogate",
      "expect": "bad_format",
      "frame": {
        "t": "revoke",
        "agent": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1",
        "origin": "https://inkwell.example/\ud800"
      }
    },
    {
      "name": "raw: keys out of order are non-canonical",
      "expect": "non_canonical",
      "raw": "{\"t\":\"revoke\",\"agent\":\"a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\",\"origin\":\"https://inkwell.example\"}"
    },
    {
      "name": "raw: __proto__ smuggle is just an unknown key",
      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{},\"agent\":\"a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1\",\"origin\":\"https://inkwell.example\",\"t\":\"revoke\"}"
    }
  ]
}
