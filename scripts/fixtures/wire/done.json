{
  "type": "done",
  "cases": [
    {
      "name": "minimal valid",
      "expect": "ok",
      "frame": {
        "t": "done",
        "s": "s1",
        "promptId": "p1",
        "stopReason": "end_turn"
      }
    },
    {
      "name": "cancelled without error detail",
      "expect": "ok",
      "frame": {
        "t": "done",
        "s": "s1",
        "promptId": "p1",
        "stopReason": "cancelled"
      }
    },
    {
      "name": "maximal valid: error detail at 1024-char limit",
      "expect": "ok",
      "frame": {
        "t": "done",
        "s": "s1",
        "promptId": "p1",
        "stopReason": "error",
        "error": ""
      }
    },
    {
      "name": "missing stopReason",
      "expect": "missing_key",
      "frame": {
        "t": "done",
        "s": "s1",
        "promptId": "p1"
      }
    },
    {
      "name": "unknown extra key",
      "expect": "unexpected_key",
      "frame": {
        "t": "done",
        "s": "s1",
        "promptId": "p1",
        "stopReason": "end_turn",
        "usage": {}
      }
    },
    {
      "name": "s is a number",
      "expect": "wrong_type",
      "frame": {
        "t": "done",
        "s": 12,
        "promptId": "p1",
        "stopReason": "end_turn"
      }
    },
    {
      "name": "stopReason outside enum",
      "expect": "bad_format",
      "frame": {
        "t": "done",
        "s": "s1",
        "promptId": "p1",
        "stopReason": "stop"
      }
    },
    {
      "name": "error detail one char over limit",
      "expect": "too_long",
      "frame": {
        "t": "done",
        "s": "s1",
        "promptId": "p1",
        "stopReason": "error",
        "error": ""
      }
    },
    {
      "name": "raw: whitespace is non-canonical",
      "expect": "non_canonical",
      "raw": "{\"t\":\"done\",\"s\":\"s1\",\"promptId\":\"p1\", \"stopReason\":\"end_turn\"}"
    },
    {
      "name": "raw: __proto__ smuggle",
      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{},\"promptId\":\"p1\",\"s\":\"s1\",\"stopReason\":\"end_turn\",\"t\":\"done\"}"
    }
  ]
}
