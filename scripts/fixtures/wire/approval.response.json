{
  "type": "approval.response",
  "cases": [
    {
      "name": "minimal valid (granted)",
      "expect": "ok",
      "frame": {
        "t": "approval.response",
        "s": "s1",
        "id": "a1",
        "granted": true
      }
    },
    {
      "name": "denied, s at 64-char limit",
      "expect": "ok",
      "frame": {
        "t": "approval.response",
        "s": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.b:c",
        "id": "a1",
        "granted": false
      }
    },
    {
      "name": "missing granted",
      "expect": "missing_key",
      "frame": {
        "t": "approval.response",
        "s": "s1",
        "id": "a1"
      }
    },
    {
      "name": "unknown extra key",
      "expect": "unexpected_key",
      "frame": {
        "t": "approval.response",
        "s": "s1",
        "id": "a1",
        "granted": true,
        "note": ""
      }
    },
    {
      "name": "granted is a number",
      "expect": "wrong_type",
      "frame": {
        "t": "approval.response",
        "s": "s1",
        "id": "a1",
        "granted": 1
      }
    },
    {
      "name": "id one char over limit",
      "expect": "too_long",
      "frame": {
        "t": "approval.response",
        "s": "s1",
        "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "granted": true
      }
    },
    {
      "name": "raw: duplicate key",
      "expect": "non_canonical",
      "raw": "{\"t\":\"approval.response\",\"s\":\"s1\",\"id\":\"a1\",\"granted\":true,\"granted\":false}"
    },
    {
      "name": "raw: __proto__ smuggle",
      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{},\"granted\":true,\"id\":\"a1\",\"s\":\"s1\",\"t\":\"approval.response\"}"
    },
    {
      "name": "valid: the recomputed digest",
      "expect": "ok",
      "frame": {
        "t": "approval.response",
        "s": "s1",
        "id": "a1",
        "granted": true,
        "callHash": "b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7b7"
      }
    },
    {
      "name": "digest uppercase hex",
      "expect": "bad_format",
      "frame": {
        "t": "approval.response",
        "s": "s1",
        "id": "a1",
        "granted": true,
        "callHash": "B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7B7"
      }
    }
  ]
}
