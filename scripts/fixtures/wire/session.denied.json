{
  "type": "session.denied",
  "cases": [
    {
      "name": "minimal valid denied",
      "expect": "ok",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "revoked"
      }
    },
    {
      "name": "maximal valid: the longest registry reason",
      "expect": "ok",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "authorization_expired"
      }
    },
    {
      "name": "every relay-emitted reason decodes",
      "expect": "ok",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "agent_offline"
      }
    },
    {
      "name": "the capacity refusal decodes (transient by design)",
      "expect": "ok",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "agent_busy"
      }
    },
    {
      "name": "missing required reason",
      "expect": "missing_key",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567"
      }
    },
    {
      "name": "unknown extra key",
      "expect": "unexpected_key",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "revoked",
        "code": "denied"
      }
    },
    {
      "name": "reason is a number",
      "expect": "bad_format",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": 42
      }
    },
    {
      "name": "free text is no longer a reason (v7)",
      "expect": "bad_format",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "user declined"
      }
    },
    {
      "name": "the vocabulary is case-sensitive",
      "expect": "bad_format",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "REVOKED"
      }
    },
    {
      "name": "a registry-shaped reason that is not a member",
      "expect": "bad_format",
      "frame": {
        "t": "session.denied",
        "s": "sess_0123456789abcdef01234567",
        "reason": "totally_plausible_reason"
      }
    },
    {
      "name": "raw: escaped solidus breaks canonical form",
      "expect": "non_canonical",
      "raw": "{\"t\":\"session.denied\",\"s\":\"sess_0123456789abcdef01234567\",\"reason\":\"a\\/b\"}"
    },
    {
      "name": "raw: __proto__ key smuggle",
      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{\"polluted\":true},\"reason\":\"revoked\",\"s\":\"sess_0123456789abcdef01234567\",\"t\":\"session.denied\"}"
    }
  ]
}
