    {
      "name": "a real plan, all three statuses and priorities",
      "expect": "ok",
      "frame": {
        "t": "plan",
        "s": "s1",
        "promptId": "p1",
        "steps": [
          {
            "text": "Read the current draft",
            "status": "done",
            "priority": "high"
          },
          {
            "text": "Find the weakest paragraph",
            "status": "active",
            "priority": "medium"
          },
          {
            "text": "Rewrite it and append",
            "status": "pending",
            "priority": "low"
          }
        ]
      }
    },
