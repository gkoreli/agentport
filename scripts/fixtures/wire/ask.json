{
  "type": "ask",
  "cases": [
    {
      "name": "minimal valid \u2014 one free-text question",
      "expect": "ok",
      "frame": {
        "t": "ask",
        "s": "sess_0123456789abcdef01234567",
        "id": "ask_0123456789abcdef01234567",
        "message": "What should I call it?",
        "fields": [
          {
            "key": "f_0123456789abcdef01234567",
            "label": "Name"
          }
        ]
      }
    },
    {
      "name": "maximal valid \u2014 a bounded multi-select",
      "expect": "ok",
      "frame": {
        "t": "ask",
        "s": "sess_0123456789abcdef01234567",
        "id": "ask_0123456789abcdef01234567",
        "message": "Which draft should I revise?",
        "fields": [
          {
            "key": "f_0123456789abcdef01234567",
            "label": "Draft",
            "options": [
              "The first",
              "The second"
            ],
            "multi": true
          }
        ]
      }
    },
    {
      "name": "missing message",
      "expect": "missing_key",
      "frame": {
        "t": "ask",
        "s": "sess_0123456789abcdef01234567",
        "id": "ask_0123456789abcdef01234567",
        "fields": [
          {
            "key": "f_0123456789abcdef01234567",
            "label": "Draft",
            "options": [
              "The first",
              "The second"
            ],
            "multi": false
          }
        ]
      }
    },
    {
      "name": "empty message",
      "expect": "too_short",
      "frame": {
        "t": "ask",
        "s": "sess_0123456789abcdef01234567",
        "id": "ask_0123456789abcdef01234567",
        "message": "",
        "fields": [
          {
            "key": "f_0123456789abcdef01234567",
            "label": "Draft",
            "options": [
              "The first",
              "The second"
            ],
            "multi": false
          }
        ]
      }
    },
    {
