      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{},\"fields\":[],\"id\":\"ask_0123456789abcdef01234567\",\"message\":\"hi\",\"s\":\"sess_0123456789abcdef01234567\",\"t\":\"ask\"}"
