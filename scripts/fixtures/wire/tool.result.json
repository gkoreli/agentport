{
  "type": "tool.result",
  "cases": [
    {
      "name": "minimal valid",
      "expect": "ok",
      "frame": {
        "t": "tool.result",
        "s": "s1",
        "id": "tc1",
        "ok": true
      }
    },
    {
      "name": "maximal valid: result present, error at 1024-char limit, id at 64",
      "expect": "ok",
      "frame": {
        "t": "tool.result",
        "s": "s1",
        "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.b:c",
        "ok": false,
        "result": {
          "applied": false,
          "reason": "selection moved"
        },
        "error": ""
      }
    },
    {
      "name": "missing ok",
      "expect": "missing_key",
      "frame": {
        "t": "tool.result",
        "s": "s1",
        "id": "tc1"
      }
    },
    {
      "name": "unknown extra key",
      "expect": "unexpected_key",
      "frame": {
        "t": "tool.result",
        "s": "s1",
        "id": "tc1",
        "ok": true,
        "took": 12
      }
    },
    {
      "name": "ok is a string",
      "expect": "wrong_type",
      "frame": {
        "t": "tool.result",
        "s": "s1",
        "id": "tc1",
        "ok": "true"
      }
    },
    {
      "name": "error one char over limit",
      "expect": "too_long",
      "frame": {
        "t": "tool.result",
        "s": "s1",
        "id": "tc1",
        "ok": false,
        "error": ""
      }
    },
    {
      "name": "result nesting-depth bomb (20 levels)",
      "expect": "too_deep",
      "frame": {
        "t": "tool.result",
        "s": "s1",
        "id": "tc1",
        "ok": true,
        "result": {
          "d": {
            "d": {
              "d": {
                "d": {
                  "d": {
                    "d": {
                      "d": {
                        "d": {
                          "d": {
                            "d": {
                              "d": {
                                "d": {
                                  "d": {
                                    "d": {
                                      "d": {
                                        "d": {
                                          "d": {
                                            "d": {
                                              "d": {
                                                "leaf": true
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "raw: whitespace is non-canonical",
      "expect": "non_canonical",
      "raw": "{\"t\":\"tool.result\",\"s\":\"s1\",\"id\":\"tc1\",\"ok\":true }"
    },
    {
      "name": "raw: __proto__ smuggle",
      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{},\"id\":\"tc1\",\"ok\":true,\"s\":\"s1\",\"t\":\"tool.result\"}"
    }
  ]
}
