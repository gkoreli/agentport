    {
      "name": "raw: duplicate code key is non-canonical",
      "expect": "non_canonical",
      "raw": "{\"t\":\"error\",\"code\":\"bad_request\",\"code\":\"bad_request\",\"message\":\"\"}"
    },
    {
      "name": "raw: __proto__ smuggle is just an unknown key",
      "expect": "unexpected_key",
      "raw": "{\"__proto__\":{},\"code\":\"bad_request\",\"message\":\"\",\"t\":\"error\"}"
